{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/US.json",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/USId.json"
    },
    "title": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/NonEmptyText.json"
    },
    "type": {
      "type": "string",
      "const": "US"
    },
    "object": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/ObjectTypeName.json"
    },
    "status": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/ArtifactStatus.json"
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/Relationship.json"
      }
    },
    "provenance": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/Provenance.json"
    },
    "story": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/Story.json"
    },
    "context": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/Section.json"
    },
    "acceptanceExamples": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/Section.json",
      "description": "Illustrative by the US contract: nothing here is binding or verification criteria, so the section stays prose."
    },
    "options": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/Section.json"
    },
    "constraints": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/Section.json"
    },
    "dependencies": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/Section.json"
    },
    "priorityAndRisk": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/Section.json"
    },
    "notes": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/Section.json"
    },
    "traceability": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/Section.json"
    }
  },
  "required": [
    "id",
    "title",
    "type",
    "relationships",
    "provenance",
    "story"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "User story record (archetype `US`); every section but the story is contextual and non-binding."
}
