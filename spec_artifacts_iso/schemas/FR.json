{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/FR.json",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/FRId.json"
    },
    "title": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/NonEmptyText.json"
    },
    "type": {
      "type": "string",
      "const": "FR"
    },
    "criticality": {
      "anyOf": [
        {
          "type": "string",
          "const": "low"
        },
        {
          "type": "string",
          "const": "medium"
        },
        {
          "type": "string",
          "const": "high"
        }
      ],
      "description": "Human-assigned consequence of failure; never defaulted."
    },
    "softwareSafetyClass": {
      "anyOf": [
        {
          "type": "string",
          "const": "class-1"
        },
        {
          "type": "string",
          "const": "class-2"
        },
        {
          "type": "string",
          "const": "class-3"
        }
      ],
      "description": "Human-assigned software safety class, ordered lowest to highest rigour; never defaulted."
    },
    "softwareSafetyClassAssignedBy": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/NonEmptyText.json",
      "description": "Person who assigned the software safety class."
    },
    "softwareSafetyClassRationale": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/NonEmptyText.json",
      "description": "That person's reason for the class."
    },
    "object": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/ObjectTypeName.json"
    },
    "status": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/ArtifactStatus.json"
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/Relationship.json"
      }
    },
    "provenance": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/Provenance.json"
    },
    "description": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/Section.json"
    },
    "inputs": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/Section.json"
    },
    "outputs": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/Section.json"
    },
    "behavior": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/Section.json"
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/Constraint.json"
      },
      "minItems": 1
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/AcceptanceCriterion.json"
      },
      "minItems": 1
    },
    "invariants": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/semantic-core/0.3.3/ClauseRef.json"
      },
      "minItems": 1,
      "description": "Formal clauses from an optional `## Invariants` section (`ocl-clause` mapping); clause text is carried beside the record, never parsed."
    },
    "dependencies": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/Section.json"
    }
  },
  "required": [
    "id",
    "title",
    "type",
    "relationships",
    "provenance",
    "description",
    "acceptanceCriteria",
    "dependencies"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "Functional requirement record (archetype `FR`)."
}
