{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/0.2.0/Log.json",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "log"
    },
    "title": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/0.2.0/NonEmptyText.json"
    },
    "description": {
      "type": "string",
      "description": "free text: the frontmatter description."
    },
    "provenance": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/0.2.0/Provenance.json"
    },
    "history": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/0.2.0/LogEntry.json"
      },
      "minItems": 1
    }
  },
  "required": [
    "type",
    "provenance",
    "history"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "Update log record (archetype `log`, OKF reserved file)."
}
