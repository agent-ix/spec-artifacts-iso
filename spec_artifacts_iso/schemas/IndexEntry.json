{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/0.2.0/IndexEntry.json",
  "type": "object",
  "properties": {
    "title": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/0.2.0/NonEmptyText.json"
    },
    "href": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/0.2.0/RelativeHref.json"
    },
    "summary": {
      "type": "string",
      "description": "free text: the trailing summary after ` - `, when present."
    },
    "line": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/0.2.0/LineNumber.json"
    }
  },
  "required": [
    "title",
    "href",
    "line"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "One `* [title](href) - summary` line of an index `## Contents`."
}
