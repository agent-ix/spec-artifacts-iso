{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/NFR.json",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/NFRId.json"
    },
    "title": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/NonEmptyText.json"
    },
    "type": {
      "type": "string",
      "const": "NFR"
    },
    "qualityAttribute": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/QualityAttribute.json"
    },
    "criticality": {
      "anyOf": [
        {
          "type": "string",
          "const": "low"
        },
        {
          "type": "string",
          "const": "medium"
        },
        {
          "type": "string",
          "const": "high"
        }
      ],
      "description": "Human-assigned consequence of failure; never defaulted."
    },
    "softwareSafetyClass": {
      "anyOf": [
        {
          "type": "string",
          "const": "class-1"
        },
        {
          "type": "string",
          "const": "class-2"
        },
        {
          "type": "string",
          "const": "class-3"
        }
      ],
      "description": "Human-assigned software safety class, ordered lowest to highest rigour; never defaulted."
    },
    "softwareSafetyClassAssignedBy": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/NonEmptyText.json",
      "description": "Person who assigned the software safety class."
    },
    "softwareSafetyClassRationale": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/NonEmptyText.json",
      "description": "That person's reason for the class."
    },
    "object": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/ObjectTypeName.json"
    },
    "status": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/ArtifactStatus.json"
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/Relationship.json"
      }
    },
    "provenance": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/Provenance.json"
    },
    "statement": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/Section.json"
    },
    "scope": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/Section.json"
    },
    "rationale": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/Section.json"
    },
    "measurement": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/MeasurementRow.json"
      },
      "minItems": 1
    },
    "verification": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/Section.json"
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/AcceptanceCriterion.json"
      },
      "minItems": 1,
      "description": "Present only for a policy NFR; a measurable NFR's criteria are its measurement rows."
    },
    "dependencies": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/Section.json"
    }
  },
  "required": [
    "id",
    "title",
    "type",
    "relationships",
    "provenance",
    "statement",
    "measurement",
    "verification"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "Non-functional requirement record (archetype `NFR`)."
}
