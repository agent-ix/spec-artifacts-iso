{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/ValidationCriterion.json",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/ValidationCriterionId.json"
    },
    "criteria": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/NonEmptyText.json",
      "description": "free text: the criterion statement."
    },
    "validation": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/Verification.json"
    },
    "line": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/LineNumber.json"
    }
  },
  "required": [
    "id",
    "criteria",
    "validation",
    "line"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "One `## Validation Criteria` row of a stakeholder requirement (`ID | Criteria | Validation`)."
}
