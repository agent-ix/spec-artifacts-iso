{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/LogEntry.json",
  "type": "object",
  "properties": {
    "date": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/IsoDate.json"
    },
    "text": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/NonEmptyText.json",
      "description": "free text: the entry body after the date."
    },
    "line": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/LineNumber.json"
    }
  },
  "required": [
    "date",
    "text",
    "line"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "One `* **YYYY-MM-DD** — text` entry of a log `## History`."
}
