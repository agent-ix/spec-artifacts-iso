{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/0.2.0/AcceptanceCriterion.json",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/0.2.0/AcceptanceCriterionId.json"
    },
    "criteria": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/0.2.0/NonEmptyText.json",
      "description": "free text: the criterion statement; measurability is judged by review and the EARS advisory."
    },
    "verification": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/0.2.0/Verification.json"
    },
    "detail": {
      "type": "string",
      "description": "free text: body of a supplementary `### <criterion id>` subsection, when one exists."
    },
    "line": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/0.2.0/LineNumber.json"
    }
  },
  "required": [
    "id",
    "criteria",
    "verification",
    "line"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "One `## Acceptance Criteria` row (`ID | Criteria | Verification`)."
}
