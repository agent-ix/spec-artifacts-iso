{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/0.2.0/MeasurementRow.json",
  "type": "object",
  "properties": {
    "metric": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/0.2.0/NonEmptyText.json",
      "description": "free text: the metric name."
    },
    "target": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/0.2.0/NonEmptyText.json",
      "description": "free text: a prose quantity with its unit (`600 imports/s`); typing it needs a unit grammar this module does not own."
    },
    "threshold": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/0.2.0/NonEmptyText.json",
      "description": "free text: a prose quantity, as `target`."
    },
    "method": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/0.2.0/NonEmptyText.json",
      "description": "free text: the measurement method in the author's words."
    },
    "line": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/0.2.0/LineNumber.json"
    }
  },
  "required": [
    "metric",
    "target",
    "threshold",
    "method",
    "line"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "One `## Measurement and Evaluation` row (`Metric | Target | Threshold | Method`)."
}
