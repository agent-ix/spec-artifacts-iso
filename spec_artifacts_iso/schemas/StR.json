{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/StR.json",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/StRId.json"
    },
    "title": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/NonEmptyText.json"
    },
    "type": {
      "type": "string",
      "const": "StR"
    },
    "criticality": {
      "anyOf": [
        {
          "type": "string",
          "const": "low"
        },
        {
          "type": "string",
          "const": "medium"
        },
        {
          "type": "string",
          "const": "high"
        }
      ],
      "description": "Human-assigned consequence of failure; never defaulted."
    },
    "softwareSafetyClass": {
      "anyOf": [
        {
          "type": "string",
          "const": "class-1"
        },
        {
          "type": "string",
          "const": "class-2"
        },
        {
          "type": "string",
          "const": "class-3"
        }
      ],
      "description": "Human-assigned software safety class, ordered lowest to highest rigour; never defaulted."
    },
    "softwareSafetyClassAssignedBy": {
      "type": "string",
      "description": "free text: a person's name, assigned by a human and verified by the signed git history of the file, not by this module."
    },
    "softwareSafetyClassRationale": {
      "type": "string",
      "description": "free text: the assigner's reason for the class; judged by a human reviewer, not by a schema."
    },
    "object": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/ObjectTypeName.json"
    },
    "status": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/ArtifactStatus.json"
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/Relationship.json"
      }
    },
    "provenance": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/Provenance.json"
    },
    "stakeholderNeed": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/Section.json"
    },
    "rationale": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/Section.json"
    },
    "validationCriteria": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/ValidationCriterion.json"
      },
      "minItems": 1
    },
    "stakeholders": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/Section.json"
    },
    "contextAndAssumptions": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/Section.json"
    },
    "stakeholderConstraints": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/Section.json"
    },
    "dependencies": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/Section.json"
    },
    "priorityAndRisk": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/Section.json"
    },
    "notes": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/Section.json"
    },
    "traceability": {
      "$ref": "https://schemas.agent-ix.org/agent-ix/spec-artifacts-iso/Section.json"
    }
  },
  "required": [
    "id",
    "title",
    "type",
    "relationships",
    "provenance",
    "stakeholderNeed",
    "rationale",
    "validationCriteria"
  ],
  "unevaluatedProperties": {
    "not": {}
  },
  "description": "Stakeholder requirement record (archetype `StR`)."
}
